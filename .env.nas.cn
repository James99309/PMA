# 中国 NAS WebDAV 存储配置（通过 Cloudflare 隧道外网访问）
# 用途: 本地开发连接 SP8D 生产环境的文件存储
# 生成日期: 2026-02-10

# ===== NAS WebDAV 连接配置 =====

# 内网地址（留空 - 本地在新加坡网段，无法直连中国 NAS 内网）
SYNOLOGY_WEBDAV_INTERNAL_URL=

# 外网地址（Cloudflare Tunnel）
SYNOLOGY_WEBDAV_EXTERNAL_URL=https://webdav.jamesgpone.win

# WebDAV 认证
SYNOLOGY_WEBDAV_USER=pma-storage
SYNOLOGY_WEBDAV_PASSWORD=1505562299AaBb

# WebDAV 共享文件夹路径
SYNOLOGY_WEBDAV_PATH=/pma-files

# SSL 证书验证
SYNOLOGY_WEBDAV_VERIFY_SSL=false

# 超时设置（秒）- 外网比内网慢，适当放宽
SYNOLOGY_WEBDAV_TIMEOUT=30
SYNOLOGY_WEBDAV_CONNECT_TIMEOUT=5


# ===== 系统标识 =====

# 系统标识符（用于存储路径前缀，避免以 LOCAL- 开头导致 is_cloud 误判）
SYSTEM_IDENTIFIER=DEV-PMA


# ===== 智能存储策略配置 =====

# 是否启用 NAS 存储
NAS_STORAGE_ENABLED=true

# 阻止 Supabase 自动加载（本地开发使用NAS时设置）
FORCE_LOCAL_STORAGE=true

# 上传到 NAS 后是否同步到 Supabase（已停用 Supabase）
NAS_SYNC_TO_SUPABASE=false

# NAS 不可用时是否回退到 Supabase（已停用 Supabase）
NAS_FALLBACK_TO_SUPABASE=false
