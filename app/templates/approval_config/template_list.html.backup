{% extends "base.html" %}
{% from 'macros/ui_helpers.html' import render_button, render_data_list %}

{% block title %}审批流程模板管理{% endblock %}

{% block content %}
<div class="container-fluid page-with-fixed-nav">
    <!-- 标准化页面头部区域：标题与操作按钮在同一行 -->
    <div class="page-header-with-actions mb-4">
        <div class="row align-items-center">
            <div class="col-auto">
                <h1 class="page-title mb-0">审批流程模板管理</h1>
            </div>
            <div class="col text-end">
                <!-- 操作按钮组 -->
                <div class="btn-toolbar justify-content-end" role="toolbar">
                    {{ render_button('创建模板', href=url_for('approval_config.create_template'), color='primary', icon='fas fa-plus') }}
                </div>
            </div>
        </div>
    </div>

    <!-- 使用通用列表组件，传入自定义表格内容 -->
    {% call render_data_list(list_config) %}
        <!-- 自定义表格内容将通过 include 加载 -->
        {% include 'approval_config/template_list_data.html' %}
    {% endcall %}
</div>
{% endblock %}

{% block head %}
  <!-- 审批配置样式 -->
  <link rel="stylesheet" href="{{ url_for('static', filename='css/approval-config.css') }}">

  <!-- 通用数据列表组件样式 -->
  <link rel="stylesheet" href="{{ url_for('static', filename='css/data-list.css') }}">

  <!-- 筛选搜索组件样式 -->
  <link rel="stylesheet" href="{{ url_for('static', filename='css/filter-search.css') }}">
{% endblock %}

{% block scripts %}
  <!-- 通用数据列表组件 -->
  <script src="{{ url_for('static', filename='js/data-list.js') }}"></script>

  <!-- 审批配置重构模块 -->
  <script src="{{ url_for('static', filename='js/approval_config/approval-config.js') }}"></script>

  <!-- 模板专用功能 -->
  <script>
    // 删除模板确认函数
    function showDeleteConfirm(templateId, templateName) {
      if (typeof window.showConfirmDialog === 'function') {
        window.showConfirmDialog({
          title: '确认删除模板',
          message: `确定要删除模板 "${templateName}" 吗？\n\n删除后无法恢复，请谨慎操作。`,
          type: 'danger',
          confirmText: '确认删除',
          cancelText: '取消',
          dialogId: 'templateDeleteDialog',
          onConfirm: function() {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/admin/approval/process/${templateId}/delete`;

            const csrfToken = document.createElement('input');
            csrfToken.type = 'hidden';
            csrfToken.name = 'csrf_token';
            csrfToken.value = {{ csrf_token()|tojson }};
            form.appendChild(csrfToken);

            document.body.appendChild(form);
            form.submit();
          }
        });
      } else {
        if (confirm(`确定要删除模板 "${templateName}" 吗？`)) {
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = `/admin/approval/process/${templateId}/delete`;

          const csrfToken = document.createElement('input');
          csrfToken.type = 'hidden';
          csrfToken.name = 'csrf_token';
          csrfToken.value = {{ csrf_token()|tojson }};
          form.appendChild(csrfToken);

          document.body.appendChild(form);
          form.submit();
        }
      }
    }

    // 启用/禁用模板确认函数
    function confirmToggleTemplate(templateId, templateName, isActive) {
      const action = isActive ? '禁用' : '启用';
      if (confirm(`确定要${action}模板 "${templateName}" 吗？`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/admin/approval/process/${templateId}/toggle`;

        const csrfToken = document.createElement('input');
        csrfToken.type = 'hidden';
        csrfToken.name = 'csrf_token';
        csrfToken.value = {{ csrf_token()|tojson }};
        form.appendChild(csrfToken);

        const isActiveInput = document.createElement('input');
        isActiveInput.type = 'hidden';
        isActiveInput.name = 'is_active';
        isActiveInput.value = !isActive;
        form.appendChild(isActiveInput);

        document.body.appendChild(form);
        form.submit();
      }
    }

    // 初始化数据列表组件
    document.addEventListener('DOMContentLoaded', function() {
      // 配置审批模板数据列表
      const templateListConfig = {
        module_name: '{{ list_config.module_name }}',
        ajax_mode: {{ 'true' if list_config.ajax_mode else 'false' }},
        filter: {{ list_config.filter | tojson | safe }},
        table: {{ list_config.table | tojson | safe }},
        i18n: {
          items: '{{ _("项") }}',
          loading: '{{ _("加载中") }}',
          noData: '{{ _("暂无数据") }}',
          loadingData: '{{ _("正在加载数据...") }}',
          searchPlaceholder: '{{ _("搜索...") }}',
          resetFilters: '{{ _("重置筛选") }}'
        }
      };

      // 初始化数据列表
      if (typeof window.initDataList === 'function') {
        window.initDataList(templateListConfig);
      }
    });
  </script>
{% endblock %} 