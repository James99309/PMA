# PMA 中国 DS925+ 部署环境变量配置
# 复制此文件为 .env 并修改配置
# cp .env.example .env

# ============ 必需配置 ============

# 数据库密码（请修改为强密码）
POSTGRES_PASSWORD=pma_secure_password_2025

# Flask 密钥（请修改为随机字符串，至少32位）
SECRET_KEY=change-this-to-a-random-string-at-least-32-chars

# PMA 对外端口（NAS 本机）
PMA_PORT=5001

# ============ 群晖 WebDAV 配置 ============

# DS925+ 内网 IP 和 WebDAV 端口
SYNOLOGY_WEBDAV_URL=http://192.168.31.91:5005
SYNOLOGY_WEBDAV_INTERNAL_URL=http://192.168.31.91:5005

# 外网 WebDAV 地址（通过 FRP 穿透，暂留空）
SYNOLOGY_WEBDAV_EXTERNAL_URL=

# WebDAV 用户名和密码
SYNOLOGY_WEBDAV_USER=pma-storage
SYNOLOGY_WEBDAV_PASSWORD=your-webdav-password

# WebDAV 基础路径
SYNOLOGY_WEBDAV_PATH=/pma-files

# ============ 外网访问配置 ============

# FRP 外网访问地址（配置 FRP 后填写）
# 例如: https://pma.yourdomain.com
EXTERNAL_URL=

# ============ Supabase 备份配置（可选） ============

# 是否同步到 Supabase 云端备份
NAS_SYNC_TO_SUPABASE=false

# NAS 不可用时是否回退到 Supabase
NAS_FALLBACK_TO_SUPABASE=false

# Supabase 配置（如启用备份则需要）
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_KEY=xxx

# ============ 跨系统API配置 ============
# OVS调用SP8D时的验证密钥
CROSS_SYSTEM_API_KEY=your-cross-system-api-key

# ============ 邮件配置（中国环境） ============
# Gmail SMTP 在中国被防火墙阻止，需使用国内邮件服务

# 腾讯企业邮箱（推荐）
MAIL_SERVER=smtp.exmail.qq.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your-email-password-or-auth-code
MAIL_DEFAULT_SENDER=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# 备选方案1：阿里云邮件推送
# MAIL_SERVER=smtpdm.aliyun.com
# MAIL_PORT=465
# MAIL_USE_TLS=false
# MAIL_USE_SSL=true

# 备选方案2：163网易邮箱
# MAIL_SERVER=smtp.163.com
# MAIL_PORT=465
# MAIL_USE_TLS=false
# MAIL_USE_SSL=true

# 备选方案3：QQ邮箱
# MAIL_SERVER=smtp.qq.com
# MAIL_PORT=465
# MAIL_USE_TLS=false
# MAIL_USE_SSL=true

# ============ AI 服务配置（可选） ============

# OpenAI API Key（中国网络需要通过 VPS 代理）
# OPENAI_API_KEY=sk-xxxxx

# Anthropic API Key
# 本地开发和 CN NAS 部署都通过 SG NAS 上的 OAuth 代理，
# 实际的 OAuth token 在代理端管理；这里填 dummy-oauth-proxy 即可。
# ANTHROPIC_API_KEY=dummy-oauth-proxy
# ANTHROPIC_BASE_URL=http://100.87.155.40:4321

# DeepSeek AI 聊天服务
# DEEPSEEK_API_KEY=sk-xxxxx

# Tavily 网络搜索 API（AI 回填客户/项目信息功能必需）
# 申请地址: https://app.tavily.com
# TAVILY_API_KEY=tvly-xxxxx

# ============ Wiki 知识库配置（可选） ============
# Wiki 模块使用 Karpathy LLM Wiki 方案，通过 Anthropic Claude Opus
# 把原始文件编译为结构化 Markdown Wiki。Opus 调用复用上面的
# ANTHROPIC_API_KEY + ANTHROPIC_BASE_URL，不需要额外配置 key。

# 模型选择（默认全部 Opus，可单独覆盖）
# WIKI_INGEST_MODEL=claude-opus-4-6
# WIKI_QUERY_MODEL=claude-opus-4-6
# WIKI_LINT_MODEL=claude-opus-4-6
# WIKI_META_MODEL=claude-haiku-4-5-20251001

# Wiki 文件存储根目录（留空则默认 <PMA_ROOT>/storage/knowledge_base）
# NAS 部署建议指向持久化卷
# WIKI_ROOT=/srv/pma/storage/knowledge_base

# HTTP 请求超时（秒），Ingest 编译可能较慢
# WIKI_HTTP_TIMEOUT=180

# ============ OpenClaw 集成（可选） ============

# OpenClaw Gateway WebSocket 地址（新加坡 Mac 的 Tailscale IP）
# OPENCLAW_GATEWAY_URL=ws://100.x.x.x:3000
# OPENCLAW_GATEWAY_TOKEN=your-openclaw-gateway-token

# OpenClaw 数据库查询 API 认证 token（python3 -c "import secrets; print(secrets.token_urlsafe(32))"）
# PMA_AI_QUERY_TOKEN=your-random-token

# PMA 自身的 API 基础地址（供 OpenClaw 回调查询数据库）
# PMA_API_BASE_URL=http://100.x.x.x:5001

# ============ FRP 配置 ============

# FRP 服务器地址（你的 VPS 公网 IP 或域名）
# FRP_SERVER_ADDR=your-vps-ip
# FRP_SERVER_PORT=7000
# FRP_TOKEN=your-frp-auth-token

# ============ 时区 ============
TZ=Asia/Shanghai
