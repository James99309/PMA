# PMA 中国 DS925+ 部署环境变量配置
# 复制此文件为 .env 并修改配置
# cp .env.example .env

# ============ 必需配置 ============

# 数据库密码（请修改为强密码）
POSTGRES_PASSWORD=pma_secure_password_2025

# Flask 密钥（请修改为随机字符串，至少32位）
SECRET_KEY=change-this-to-a-random-string-at-least-32-chars

# PMA 对外端口（NAS 本机）
PMA_PORT=5001

# ============ 群晖 WebDAV 配置 ============

# DS925+ 内网 IP 和 WebDAV 端口
SYNOLOGY_WEBDAV_URL=http://192.168.31.91:5005
SYNOLOGY_WEBDAV_INTERNAL_URL=http://192.168.31.91:5005

# 外网 WebDAV 地址（通过 FRP 穿透，暂留空）
SYNOLOGY_WEBDAV_EXTERNAL_URL=

# WebDAV 用户名和密码
SYNOLOGY_WEBDAV_USER=pma-storage
SYNOLOGY_WEBDAV_PASSWORD=your-webdav-password

# WebDAV 基础路径
SYNOLOGY_WEBDAV_PATH=/pma-files

# ============ 外网访问配置 ============

# FRP 外网访问地址（配置 FRP 后填写）
# 例如: https://pma.yourdomain.com
EXTERNAL_URL=

# ============ Supabase 备份配置（可选） ============

# 是否同步到 Supabase 云端备份
NAS_SYNC_TO_SUPABASE=false

# NAS 不可用时是否回退到 Supabase
NAS_FALLBACK_TO_SUPABASE=false

# Supabase 配置（如启用备份则需要）
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_KEY=xxx

# ============ 跨系统API配置 ============
# OVS调用SP8D时的验证密钥
CROSS_SYSTEM_API_KEY=your-cross-system-api-key

# ============ 邮件配置（中国环境） ============
# Gmail SMTP 在中国被防火墙阻止，需使用国内邮件服务

# 腾讯企业邮箱（推荐）
MAIL_SERVER=smtp.exmail.qq.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your-email-password-or-auth-code
MAIL_DEFAULT_SENDER=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# 备选方案1：阿里云邮件推送
# MAIL_SERVER=smtpdm.aliyun.com
# MAIL_PORT=465
# MAIL_USE_TLS=false
# MAIL_USE_SSL=true

# 备选方案2：163网易邮箱
# MAIL_SERVER=smtp.163.com
# MAIL_PORT=465
# MAIL_USE_TLS=false
# MAIL_USE_SSL=true

# 备选方案3：QQ邮箱
# MAIL_SERVER=smtp.qq.com
# MAIL_PORT=465
# MAIL_USE_TLS=false
# MAIL_USE_SSL=true

# ============ AI 服务配置（可选） ============

# OpenAI API Key（中国网络需要通过 VPS 代理）
# OPENAI_API_KEY=sk-xxxxx

# Anthropic API Key（可选）
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# ============ FRP 配置 ============

# FRP 服务器地址（你的 VPS 公网 IP 或域名）
# FRP_SERVER_ADDR=your-vps-ip
# FRP_SERVER_PORT=7000
# FRP_TOKEN=your-frp-auth-token

# ============ 时区 ============
TZ=Asia/Shanghai
