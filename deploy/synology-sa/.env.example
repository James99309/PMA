# PMA-SA (OVS) 新加坡 DS925+ 部署环境变量配置
# 复制此文件为 .env 并修改配置
# cp .env.example .env

# ============ 必需配置 ============

# 数据库密码（请修改为强密码）
POSTGRES_PASSWORD=pma_secure_password_2025

# Flask 密钥（请修改为随机字符串，至少32位）
SECRET_KEY=change-this-to-a-random-string-at-least-32-chars

# PMA 对外端口（NAS 本机）
PMA_PORT=5002

# ============ 群晖 WebDAV 配置 ============

# DS925+ 内网 IP 和 WebDAV 端口
SYNOLOGY_WEBDAV_URL=http://192.168.1.2:5005
SYNOLOGY_WEBDAV_INTERNAL_URL=http://192.168.1.2:5005

# 外网 WebDAV 地址（通过 Cloudflare Tunnel）
SYNOLOGY_WEBDAV_EXTERNAL_URL=https://webdav.jamesgpone.win

# WebDAV 用户名和密码
SYNOLOGY_WEBDAV_USER=pma-storage
SYNOLOGY_WEBDAV_PASSWORD=your-webdav-password

# WebDAV 基础路径
SYNOLOGY_WEBDAV_PATH=/pma-files

# ============ 外网访问配置 ============

# Cloudflare Tunnel 域名
EXTERNAL_URL=https://sg-pma.jamesgpone.win

# ============ SP8D远程API配置（产品模板引入） ============
SP8D_API_BASE_URL=https://pma.jamesgpone.win/api/v1
SP8D_API_KEY=your-cross-system-api-key

# ============ 邮件配置（Gmail SMTP） ============

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
ADMIN_EMAIL=admin@yourdomain.com

# ============ AI 服务配置（可选） ============

# OpenAI API Key
# OPENAI_API_KEY=sk-xxxxx

# Anthropic API Key
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# ============ 时区 ============
TZ=Asia/Singapore
