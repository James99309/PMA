# PMA 群晖部署环境变量配置
# 复制此文件为 .env 并修改配置

# ============ 必需配置 ============

# 数据库密码（请修改为强密码）
POSTGRES_PASSWORD=pma_secure_password_2025

# Flask 密钥（请修改为随机字符串）
SECRET_KEY=change-this-to-a-random-string-at-least-32-chars

# PMA 对外端口
PMA_PORT=5001

# ============ 群晖 WebDAV 配置（会议录音存储） ============

# 群晖 WebDAV 地址（内网 IP）
SYNOLOGY_WEBDAV_URL=https://192.168.1.2:5006

# WebDAV 用户名
SYNOLOGY_WEBDAV_USER=pma-storage

# WebDAV 密码
SYNOLOGY_WEBDAV_PASSWORD=your-webdav-password

# WebDAV 基础路径
SYNOLOGY_WEBDAV_PATH=/pma-files

# ============ AI 服务配置（可选，用于会议纪要） ============

# OpenAI API Key（用于 Whisper 转录和 GPT 纪要）
OPENAI_API_KEY=sk-xxxxx

# Anthropic API Key（可选，用于 Claude 纪要）
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# ============ Supabase 配置（可选，用于发票/产品图片） ============

# 如果不使用 Supabase，留空即可
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_KEY=xxx

# ============ 其他配置 ============

# 时区
TZ=Asia/Singapore
