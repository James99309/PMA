# ====================================================
# NAS WebDAV 存储配置
# ====================================================
# 将此文件复制为 .env.nas 并填写实际值
# 然后在 .env 中添加: source .env.nas（或直接合并到 .env）

# ===== NAS WebDAV 连接配置 =====

# 内网地址（局域网直连，速度快）
SYNOLOGY_WEBDAV_INTERNAL_URL=http://192.168.1.2:5005

# 外网地址（Cloudflare Tunnel，外网可用）
SYNOLOGY_WEBDAV_EXTERNAL_URL=https://medicine-maiden-concerts-interpreted.trycloudflare.com

# WebDAV 认证
SYNOLOGY_WEBDAV_USER=pma-storage
SYNOLOGY_WEBDAV_PASSWORD=your_password_here

# WebDAV 共享文件夹路径
SYNOLOGY_WEBDAV_PATH=/pma-files

# SSL 证书验证（内网自签名证书设为 false）
SYNOLOGY_WEBDAV_VERIFY_SSL=false

# 超时设置（秒）
SYNOLOGY_WEBDAV_TIMEOUT=30
SYNOLOGY_WEBDAV_CONNECT_TIMEOUT=3


# ===== 智能存储策略配置 =====

# 是否启用 NAS 存储
NAS_STORAGE_ENABLED=true

# 上传到 NAS 后是否同步到 Supabase（备份）
NAS_SYNC_TO_SUPABASE=true

# NAS 不可用时是否回退到 Supabase
NAS_FALLBACK_TO_SUPABASE=true


# ===== 系统标识（用于文件路径） =====
# SYSTEM_IDENTIFIER=PMA-SA


# ====================================================
# 配置说明
# ====================================================
#
# 内外网自动切换：
#   - 系统会自动检测内网是否可达
#   - 内网可达时使用 INTERNAL_URL（速度快）
#   - 内网不可达时使用 EXTERNAL_URL（Cloudflare Tunnel）
#
# 存储策略：
#   - 上传时优先使用 NAS
#   - NAS 上传成功后，异步同步到 Supabase（作为备份）
#   - NAS 不可用时，直接上传到 Supabase（回退）
#   - 用户访问文件时优先从 NAS 获取
#
# Cloudflare Tunnel 地址可能变化：
#   - Quick Tunnel 地址在重启后会改变
#   - 建议使用 Cloudflare 命名隧道获取固定地址
#   - 或在 NAS 重启后更新此配置
#
# ====================================================
